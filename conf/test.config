// Small cropped bundle built by tests/make_test_bundle.py (zip input, all optional side inputs)
params {
    bundle       = "${projectDir}/tests/data/test_bundle_outs.zip"
    sample       = 'test'
    he_alignment = "${projectDir}/tests/data/test_inputs/he_imagealignment.csv"
    keypoints    = "${projectDir}/tests/data/test_inputs/keypoints.csv"
    annotation   = "${projectDir}/tests/data/test_inputs/annotation.geojson"
    outdir       = 'results_test'
    max_cpus     = 4
    max_memory   = '12.GB'
}
