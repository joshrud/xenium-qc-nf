// Resource labels. Requests above --max_cpus / --max_memory / --max_time are capped (resourceLimits).
process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as nextflow.util.MemoryUnit,
                      time: params.max_time as nextflow.util.Duration]
    cpus   = 1
    memory = 4.GB
    time   = 2.h
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single { cpus = 1; memory = { 6.GB * task.attempt } }
    withLabel: process_medium { cpus = 4; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: process_high   { cpus = 6; memory = { 24.GB * task.attempt }; time = { 6.h * task.attempt } }
}
