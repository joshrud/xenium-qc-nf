// Every step publishes its folder to <outdir>/<sample>/<step>/{figures,tables,metrics,logs}
process {
    publishDir = [
        path: { "${params.outdir}/${meta.id}" },
        mode: params.publish_dir_mode,
        // skip the unpacked bundle and files that are already inside a published step folder
        saveAs: { fn -> (fn == 'bundle' || fn.contains('/')) ? null : fn },
    ]
}
