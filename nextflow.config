manifest {
    name            = 'xenium-qc-nf'
    author          = 'Josh Rudolph'
    homePage        = 'https://github.com/joshrud/xenium-qc-nf'
    description     = 'QC and H&E alignment checks for 10x Xenium Onboard Analysis output bundles (companion to nf-core/spatialaxe)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

params {
    // ---- input: a samplesheet (sample,bundle,image,alignment,keypoints,annotation,reference_alignment) ...
    input               = null
    // ... or a single bundle (.zip or unpacked folder) with optional side inputs
    bundle              = null
    sample              = 'sample'
    he_image            = null      // post-run H&E OME-TIFF (enables H&E crops)
    he_alignment        = null      // 3x3 H&E-px -> DAPI-px matrix (your Xenium Explorer export)
    keypoints           = null      // Xenium Explorer keypoints.csv
    annotation          = null      // pathology GeoJSON
    reference_alignment = null      // second matrix to compare against (e.g. 10x supplemental alignment)

    outdir              = 'results'
    publish_dir_mode    = 'copy'
    markers             = null      // marker YAML; default: xenium_qc/data/markers_default.yaml

    // ---- step options
    unzip_all           = false     // also extract morphology.ome.tif, zarr archives, tarballs
    bin_um              = 20
    seam_window         = 31
    min_counts          = 10
    min_cells_per_gene  = 5
    mad_k               = 5
    target_sum          = 100
    leiden_resolution   = 1.0
    annotation_units    = 'he_px'   // 'he_px' (drawn on the H&E) or 'um' (Xenium microns)
    skip_multiqc        = false
    skip_he_crops       = false

    // ---- environment / resources
    venv                = null      // optional Python venv with xenium_qc installed (local profile)
    max_cpus            = 8
    max_memory          = '48.GB'
    max_time            = '24.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    local {
        process.executor = 'local'
    }
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'xenium-qc-nf:0.1.0'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Put a venv's bin/ (with the `xqc` entry point) first on PATH when --venv is given
process.beforeScript = params.venv ? "export PATH=${params.venv}/bin:\$PATH" : ''

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html" }
